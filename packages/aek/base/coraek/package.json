{
  "name": "@cheezmil/coraek",
  "description": "AEK base identity layer: pins the AEK home dir and prints the `aek web:` startup line; the client half is an identity no-op (aek-home owns the surface)",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "aek": "bin/aek.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.mjs"
    },
    "./types": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./home": {
      "types": "./home.d.mts",
      "default": "./home.mjs"
    },
    "./slots": {
      "types": "./slots.d.mts",
      "default": "./slots.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./slot-lock": {
      "types": "./slot-lock.d.mts",
      "default": "./slot-lock.mjs"
    }
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "build": "tsdown",
    "build:cli": "tsdown -c tsdown.cli.config.ts",
    "prepack": "pnpm run build && pnpm run build:cli"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/cosmokit": ">=1.8.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "home.mjs",
    "home.d.mts",
    "slots.mjs",
    "slots.d.mts",
    "lib/index.js",
    "lib/client.js",
    "lib/cli.mjs",
    "lib/aek-cli.mjs",
    "lib/commands/*.mjs",
    "lib/types/**/*.d.ts",
    "bin/",
    "slot-lock.mjs",
    "slot-lock.d.mts"
  ],
  "oclif": {
    "bin": "aek",
    "dirname": "aek",
    "commands": "lib/commands",
    "plugins": [],
    "topicSeparator": " "
  },
  "aek": {
    "type": "dsh-plugin",
    "description": "AEK identity layer: re-exports Context/Volatile/ClientContext types and prints the aek web: readiness line"
  },
  "dependencies": {
    "@oclif/core": "^5.1.11"
  }
}
