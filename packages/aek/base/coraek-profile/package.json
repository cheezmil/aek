{
  "name": "@cheezmil/coraek-profile",
  "description": "coraek profile assembly layer: a cordis patch that inserts the AEK identity, web-search admin API, and aek-home root into a dsh web profile",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "cordis.patch.yml",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "aek": {
    "type": "dsh-bundle",
    "description": "coraek profile layer: declares which AEK plugins a web profile mounts; contains no runtime code",
    "distribution": "A1"
  },
  "dependencies": {
    "@cheezmil/aek-home": "0.0.4",
    "@cheezmil/aek-websearch": "1.1.15",
    "@cheezmil/coraek": "1.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "scripts": {
    "check": "cat cordis.patch.yml"
  }
}
