{
  "name": "@cheezmil/aek-home",
  "description": "AEK home surface: the React application root aek-home renders directly into #root, replacing the dsh shell",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@cheezmil/coraek": "^1.0.0",
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@cheezmil/coraek": "^1.0.0",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "aek": {
    "type": "dsh-bundle",
    "description": "AEK home surface \u2014 client-side UI root that replaces the dsh shell"
  }
}
