{
  "name": "@cheezmil/aek-ui-gallery",
  "description": "shadcn/ui 全组件风格画廊：在线预览整套 shadcn/ui 组件，挑选并套用一套整站 UI 风格",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.mts",
    "dist",
    "NOTICE",
    "licenses/",
    "skills/aek-ui-gallery/"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown && vite build",
    "clean": "rm -rf lib dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "aek": {
    "type": "dsh-plugin",
    "cordis": true,
    "dsh": false,
    "description": "shadcn/ui component gallery: preview the full shadcn/ui component set and apply one UI style across the whole console",
    "distribution": "A1",
    "bucket": "plugins"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "dependencies": {
    "@cheezmil/coraek": "workspace:*"
  },
  "devDependencies": {
    "@base-ui/react": "1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.2.0",
    "@iconify/react": "^6.0.2",
    "@number-flow/react": "^0.6.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@shadcn/react": "^0.3.1",
    "@shikijs/transformers": "^1.24.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "hast-util-to-jsx-runtime": "^2.3.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "motion": "^11.18.2",
    "next-themes": "^0.4.3",
    "radix-ui": "latest",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.2.10",
    "react-hook-form": "^7.53.1",
    "react-resizable-panels": "^4.12.0",
    "recharts": "3.8.0",
    "shadcn": "^3.6.3",
    "shiki": "^1.23.0",
    "simplebar-react": "^3.3.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.167.1",
    "to-path-tree": "^1.2.4",
    "tsdown": "^0.23",
    "tsx": "^4.23",
    "tw-animate-css": "^1.3.7",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "vite": "^6.4.3",
    "zod": "^3.24.1"
  }
}
