{
  // Standalone NodeNext config — intentionally NOT extending the repo
  // tsconfig.base.json: the ported engine (upstream shenysun/skills-manager)
  // is written against plain `strict` NodeNext, and it relies on directory
  // structure being preserved at compile time (`createRequire(import.meta.url)
  // ('../../package.json')` and `projectRootFromImportMeta` both resolve two
  // levels up from src/<x>/ or lib/<x>/ to the package root). A bundler would
  // inline those and break the relative package.json reads.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "lib",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
